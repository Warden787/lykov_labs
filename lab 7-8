import random
def matrix1(m, n):
    matrix = []
    for i in range(m):
        row = []
        for j in range(n):
            row.append(random.randint(1, 9))
        matrix.append(row)
    return matrix

def unique(matrix):
    flat = []
    for row in matrix:
        for x in row:
            flat.append(x)
    u = []
    for x in flat:
        count = 0
        for y in flat:
            if x == y:
                count += 1
        if count == 1:
            u.append(x)
    return u
